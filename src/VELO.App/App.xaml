<Application x:Class="VELO.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 — the theme. ThemeService replaces this entry in
                     place to switch light/dark at runtime; the index is
                     hardcoded there as ThemeSlot, so this must stay first.
                     Dark is the boot default; App.OnStartup re-applies the
                     persisted ui.theme once the database is open. -->
                <ResourceDictionary Source="pack://application:,,,/VELO.UI;component/Themes/Dark.xaml"/>
                <!-- Slot 1 — control styles. Theme-independent; every colour
                     inside is a DynamicResource pointing at slot 0. -->
                <ResourceDictionary Source="pack://application:,,,/VELO.UI;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
