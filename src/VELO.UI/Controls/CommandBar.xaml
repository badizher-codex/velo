<UserControl x:Class="VELO.UI.Controls.CommandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             AutomationProperties.Name="Paleta de comandos">

    <!-- Full-overlay backdrop — click outside to dismiss -->
    <Grid Background="{DynamicResource ScrimBrush}"
          MouseLeftButtonDown="Backdrop_Click">

        <!-- Palette popup — centred, fixed width, auto height -->
        <Border x:Name="PaletteBox"
                Width="540"
                MaxHeight="440"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceOverlayBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{DynamicResource ShadowLg}">

            <!-- Prevent backdrop click from reaching through the popup -->
            <Border MouseLeftButtonDown="Palette_StopBubble">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Search input -->
                        <RowDefinition Height="Auto"/>  <!-- Separator -->
                        <RowDefinition Height="*"/>     <!-- Results list -->
                    </Grid.RowDefinitions>

                    <!-- ── Search input ───────────────────────────────── -->
                    <Grid Grid.Row="0" Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⌕"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="15"
                                 VerticalAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Grid.Column="1"
                                   Text="Search tabs, commands, history…"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Separator -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            Margin="0,0,0,4"/>

                    <!-- ── Results list ───────────────────────────────── -->
                    <ListBox x:Name="ResultsList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MaxHeight="340"
                             Margin="6,0,6,8"
                             KeyDown="ResultsList_KeyDown"
                             MouseDoubleClick="ResultsList_DoubleClick"
                             SelectionChanged="ResultsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- Plain triggers, not a VisualStateManager.
                                                 The VSM version animated
                                                 (Background).(SolidColorBrush.Color) to a
                                                 literal, and a ColorAnimation target cannot
                                                 take a DynamicResource — a Storyboard is
                                                 frozen. Any state painted that way stays the
                                                 same colour after a theme swap. -->
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="10,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SurfaceSelectedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>   <!-- Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Text -->
                                        <ColumnDefinition Width="Auto"/> <!-- Badge -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <!-- Title + subtitle -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSubtitle}"/>
                                    </StackPanel>

                                    <!-- Category badge -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
