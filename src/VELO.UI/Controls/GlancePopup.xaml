<UserControl x:Class="VELO.UI.Controls.GlancePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Width="420"
             Height="280"
             Visibility="Collapsed">

    <Border Background="{DynamicResource SurfaceOverlayBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{DynamicResource ShadowLg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- WebView -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ──────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,0">
                <Grid>
                    <TextBlock x:Name="PreviewUrl"
                               Text=""
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Glance"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Preview WebView2 ───────────────────────────────────── -->
            <wv2:WebView2 x:Name="PreviewWebView"
                          Grid.Row="1"/>
        </Grid>
    </Border>
</UserControl>
