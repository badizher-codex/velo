<Window x:Class="VELO.UI.Dialogs.CaptureConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VELO — Capture media"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <!-- Phase 6 — replaces the native MessageBox that explained what a capture
         does. Two reasons it had to become a real window: a MessageBox cannot
         carry a "don't show again" checkbox, and a native one cannot be themed
         (it stays light while the rest of VELO is dark). -->
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="22"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0">
                <TextBlock Text="⏺" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="Capture audio"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="How this works"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="BodyText"
                           FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Leave it running until it ends. Closing the tab or navigating away stops the capture, and sound and speed go back to normal when it finishes."
                           FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="DontShowAgain" Grid.Row="2"
                  Content="Don't show this again for the rest of this session"
                  Foreground="{DynamicResource TextMutedBrush}"
                  FontSize="12"
                  Margin="2,0,0,18"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource GhostButton}"
                    Content="Cancel"
                    IsCancel="True"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,6,0"
                    Click="OnCancelClick"/>
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Content="Start capture"
                    IsDefault="True"
                    HorizontalAlignment="Stretch"
                    Margin="6,0,0,0"
                    Click="OnStartClick"/>
        </Grid>
    </Grid>
</Window>
