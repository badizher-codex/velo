<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════════
        VELO — Light theme tokens.

        Mirror of Dark.xaml: same key set, same roles, different values.
        ThemeTokenParityTests fails the build if the two files diverge.

        Two things a light theme is NOT allowed to be, and both are why the
        values below aren't just "the dark ones inverted":

        1. Pure white everywhere. The canvas is #F4F4F8, not #FFFFFF, so
           raised surfaces (cards, popups, inputs) can BE white and read as
           elevated. Inverting Dark.xaml would put white on white.
        2. The same accents. #7C5CFF on white is 4.0:1 — under the 4.5:1
           floor for body text. Every accent and status colour has a darker
           light-mode twin so foreground text stays legible. Fills keep the
           brighter tone because they carry white text on top.
        ════════════════════════════════════════════════════════════════════
    -->

    <!-- ── Surfaces ─────────────────────────────────────────────────────
         Inverted elevation logic: in dark, higher = lighter. In light,
         higher = whiter AND the canvas recedes to grey. -->
    <Color x:Key="SurfaceCanvas">#FFF4F4F8</Color>
    <Color x:Key="SurfaceBase">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaised">#FFFFFFFF</Color>
    <Color x:Key="SurfaceOverlay">#FFFFFFFF</Color>
    <Color x:Key="SurfaceInput">#FFFFFFFF</Color>
    <Color x:Key="SurfaceHover">#FFEDEDF3</Color>
    <Color x:Key="SurfaceActive">#FFE2E2EC</Color>
    <Color x:Key="SurfaceSelected">#FFEFEBFF</Color>
    <Color x:Key="OverlaySelected">#B3E6DEFF</Color>
    <Color x:Key="OverlayHover">#59DCDCE8</Color>
    <!-- Lighter scrim than dark's: a 70% black veil over a white app reads
         as a crash, not as a modal. -->
    <Color x:Key="Scrim">#59171727</Color>

    <!-- ── Text ─────────────────────────────────────────────────────────
         TextPrimary is #17171F, not #000000 — pure black on white is the
         highest-fatigue pairing there is. -->
    <Color x:Key="TextPrimary">#FF17171F</Color>
    <Color x:Key="TextSecondary">#FF56566A</Color>
    <Color x:Key="TextMuted">#FF85859A</Color>
    <Color x:Key="TextOnAccent">#FFFFFFFF</Color>

    <!-- ── Borders ──────────────────────────────────────────────────────
         Borders carry more weight here than in dark: without a luminance
         step between Base and Raised (both white), the border IS the
         elevation cue. -->
    <Color x:Key="BorderSubtle">#FFE3E3EC</Color>
    <Color x:Key="BorderStrong">#FFC6C6D6</Color>

    <!-- ── Accent ───────────────────────────────────────────────────────
         Accent     #6440EE → 6.0:1 against white text on top.
         AccentText #5A38DB → 6.9:1 as foreground on SurfaceBase. -->
    <Color x:Key="Accent">#FF6440EE</Color>
    <Color x:Key="AccentHover">#FF7657F5</Color>
    <Color x:Key="AccentPressed">#FF5232C4</Color>
    <Color x:Key="AccentText">#FF5A38DB</Color>
    <Color x:Key="AccentSoft">#146440EE</Color>

    <!-- ── Status ───────────────────────────────────────────────────────
         Each Status<X>Text clears 4.5:1 on SurfaceBase. The dark-theme
         tones (#34D399, #F87171, #FBBF24, #60A5FA) sit around 1.7:1 here
         and would be invisible — this is the block that catches a naive
         "just swap the background" theme. -->
    <Color x:Key="StatusSuccess">#FF059669</Color>
    <Color x:Key="StatusSuccessText">#FF047857</Color>
    <Color x:Key="StatusSuccessSoft">#1A059669</Color>

    <Color x:Key="StatusDanger">#FFDC2626</Color>
    <Color x:Key="StatusDangerText">#FFB91C1C</Color>
    <Color x:Key="StatusDangerSoft">#1ADC2626</Color>

    <Color x:Key="StatusWarning">#FFD97706</Color>
    <Color x:Key="StatusWarningText">#FFB45309</Color>
    <Color x:Key="StatusWarningSoft">#1AD97706</Color>

    <Color x:Key="StatusInfo">#FF2563EB</Color>
    <Color x:Key="StatusInfoText">#FF1D4ED8</Color>
    <Color x:Key="StatusInfoSoft">#1A2563EB</Color>

    <!-- ── Shield score (Fase 2) ────────────────────────────────────────-->
    <Color x:Key="ShieldRed">#FFDC2626</Color>
    <Color x:Key="ShieldYellow">#FFD97706</Color>
    <Color x:Key="ShieldGreen">#FF059669</Color>
    <Color x:Key="ShieldGold">#FFA87F1E</Color>
    <Color x:Key="ShieldNeutral">#FFA5A5B8</Color>

    <!-- ── Containers ───────────────────────────────────────────────────-->
    <Color x:Key="ContainerPersonal">#FF2563EB</Color>
    <Color x:Key="ContainerWork">#FF059669</Color>
    <Color x:Key="ContainerBanking">#FFE11D48</Color>
    <Color x:Key="ContainerShopping">#FFD97706</Color>
    <Color x:Key="ContainerNone">#FF85859A</Color>

    <!-- ══ Brushes ══════════════════════════════════════════════════════-->

    <SolidColorBrush x:Key="SurfaceCanvasBrush"   Color="{StaticResource SurfaceCanvas}" />
    <SolidColorBrush x:Key="SurfaceBaseBrush"     Color="{StaticResource SurfaceBase}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush"   Color="{StaticResource SurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush"  Color="{StaticResource SurfaceOverlay}" />
    <SolidColorBrush x:Key="SurfaceInputBrush"    Color="{StaticResource SurfaceInput}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush"   Color="{StaticResource SurfaceActive}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush"  Color="{StaticResource SurfaceSelected}" />
    <SolidColorBrush x:Key="OverlaySelectedBrush"  Color="{StaticResource OverlaySelected}" />
    <SolidColorBrush x:Key="OverlayHoverBrush"     Color="{StaticResource OverlayHover}" />
    <SolidColorBrush x:Key="ScrimBrush"            Color="{StaticResource Scrim}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{StaticResource TextOnAccent}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="BorderFocusBrush"  Color="{StaticResource Accent}" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="AccentTextBrush"    Color="{StaticResource AccentText}" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource AccentSoft}" />

    <SolidColorBrush x:Key="StatusSuccessBrush"     Color="{StaticResource StatusSuccess}" />
    <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="{StaticResource StatusSuccessText}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBrush" Color="{StaticResource StatusSuccessSoft}" />
    <SolidColorBrush x:Key="StatusDangerBrush"      Color="{StaticResource StatusDanger}" />
    <SolidColorBrush x:Key="StatusDangerTextBrush"  Color="{StaticResource StatusDangerText}" />
    <SolidColorBrush x:Key="StatusDangerSoftBrush"  Color="{StaticResource StatusDangerSoft}" />
    <SolidColorBrush x:Key="StatusWarningBrush"     Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusWarningTextBrush" Color="{StaticResource StatusWarningText}" />
    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="{StaticResource StatusWarningSoft}" />
    <SolidColorBrush x:Key="StatusInfoBrush"        Color="{StaticResource StatusInfo}" />
    <SolidColorBrush x:Key="StatusInfoTextBrush"    Color="{StaticResource StatusInfoText}" />
    <SolidColorBrush x:Key="StatusInfoSoftBrush"    Color="{StaticResource StatusInfoSoft}" />

    <SolidColorBrush x:Key="ShieldRedBrush"     Color="{StaticResource ShieldRed}" />
    <SolidColorBrush x:Key="ShieldYellowBrush"  Color="{StaticResource ShieldYellow}" />
    <SolidColorBrush x:Key="ShieldGreenBrush"   Color="{StaticResource ShieldGreen}" />
    <SolidColorBrush x:Key="ShieldGoldBrush"    Color="{StaticResource ShieldGold}" />
    <SolidColorBrush x:Key="ShieldNeutralBrush" Color="{StaticResource ShieldNeutral}" />

    <SolidColorBrush x:Key="ContainerPersonalBrush" Color="{StaticResource ContainerPersonal}" />
    <SolidColorBrush x:Key="ContainerWorkBrush"     Color="{StaticResource ContainerWork}" />
    <SolidColorBrush x:Key="ContainerBankingBrush"  Color="{StaticResource ContainerBanking}" />
    <SolidColorBrush x:Key="ContainerShoppingBrush" Color="{StaticResource ContainerShopping}" />
    <SolidColorBrush x:Key="ContainerNoneBrush"     Color="{StaticResource ContainerNone}" />

    <!-- ── Gradients ────────────────────────────────────────────────────-->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Accent}" Offset="0" />
        <GradientStop Color="{StaticResource AccentHover}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB91C1C" Offset="0" />
        <GradientStop Color="{StaticResource StatusDanger}" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Elevation ────────────────────────────────────────────────────
         Tinted near-navy instead of black, and far more transparent. A
         black shadow on a light UI greys the surface under it; a tinted
         one at ≤14% reads as lift. -->
    <DropShadowEffect x:Key="ShadowSm" Color="#FF1B1B2E" BlurRadius="8"  ShadowDepth="1" Direction="270" Opacity="0.10" />
    <DropShadowEffect x:Key="ShadowMd" Color="#FF1B1B2E" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.14" />
    <DropShadowEffect x:Key="ShadowLg" Color="#FF1B1B2E" BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.18" />
    <DropShadowEffect x:Key="ShadowAccent" Color="#FF6440EE" BlurRadius="16" ShadowDepth="0" Opacity="0.28" />
    <DropShadowEffect x:Key="ShadowDanger" Color="#FFDC2626" BlurRadius="14" ShadowDepth="0" Opacity="0.24" />

</ResourceDictionary>
