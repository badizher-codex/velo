<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════════
        VELO — Dark theme tokens.

        Every key defined here MUST also exist in Light.xaml with the same
        name. ThemeService swaps the whole dictionary at runtime, so a key
        present in one file and missing in the other resolves to null after
        a switch and paints nothing (DynamicResource fails silently — that
        is why the two files are kept symmetric by ThemeTokenParityTests).

        Names describe the ROLE, never the value. "SurfaceCanvas" is the
        deepest background in both themes; it happens to be near-black here
        and near-white in Light.xaml. The old v2.4 names (BackgroundDark,
        SurfaceLight, AccentBlue…) described values, which made them lie the
        moment a light theme existed.
        ════════════════════════════════════════════════════════════════════
    -->

    <!-- ── Surfaces ─────────────────────────────────────────────────────
         Canvas < Base < Raised < Overlay — increasing elevation. Each step
         is a small luminance lift, not an outline; borders do the framing. -->
    <Color x:Key="SurfaceCanvas">#FF0B0B12</Color>
    <Color x:Key="SurfaceBase">#FF121219</Color>
    <Color x:Key="SurfaceRaised">#FF17171F</Color>
    <Color x:Key="SurfaceOverlay">#FF1D1D27</Color>
    <Color x:Key="SurfaceInput">#FF16161E</Color>
    <Color x:Key="SurfaceHover">#FF232330</Color>
    <Color x:Key="SurfaceActive">#FF2C2C3C</Color>
    <!-- Selected rows carry an accent tint rather than an outline — see the
         active-tab treatment in TabSidebar. -->
    <Color x:Key="SurfaceSelected">#FF211B39</Color>
    <!-- Translucent washes, for rows that sit on top of a per-item tint (the
         sidebar's container colours) and must let it bleed through. -->
    <Color x:Key="OverlaySelected">#B31E1834</Color>
    <Color x:Key="OverlayHover">#59202030</Color>
    <Color x:Key="Scrim">#B3000000</Color>

    <!-- ── Text ─────────────────────────────────────────────────────────
         TextPrimary is deliberately not #FFFFFF: pure white on a near-black
         canvas haloes on LCD subpixel rendering and reads as "terminal". -->
    <Color x:Key="TextPrimary">#FFEDEDF2</Color>
    <Color x:Key="TextSecondary">#FFA2A2B4</Color>
    <Color x:Key="TextMuted">#FF6C6C80</Color>
    <Color x:Key="TextOnAccent">#FFFFFFFF</Color>

    <!-- ── Borders ──────────────────────────────────────────────────────-->
    <Color x:Key="BorderSubtle">#FF24242F</Color>
    <Color x:Key="BorderStrong">#FF38384C</Color>

    <!-- ── Accent ───────────────────────────────────────────────────────
         Accent      = fill (buttons, checkbox, progress)
         AccentText  = accent used AS TEXT or an icon on a normal surface;
                       the fill tone is too dark to read at 13px here.
         AccentSoft  = translucent wash for hover/selected backgrounds. -->
    <Color x:Key="Accent">#FF7C5CFF</Color>
    <Color x:Key="AccentHover">#FF8E73FF</Color>
    <Color x:Key="AccentPressed">#FF6244E0</Color>
    <Color x:Key="AccentText">#FFA996FF</Color>
    <Color x:Key="AccentSoft">#337C5CFF</Color>

    <!-- ── Status ───────────────────────────────────────────────────────
         Three tones per status for the same reason as the accent:
           Status<X>      fill / dot / bar
           Status<X>Text  readable foreground on Surface*
           Status<X>Soft  pill background -->
    <Color x:Key="StatusSuccess">#FF10B981</Color>
    <Color x:Key="StatusSuccessText">#FF34D399</Color>
    <Color x:Key="StatusSuccessSoft">#2210B981</Color>

    <Color x:Key="StatusDanger">#FFEF4444</Color>
    <Color x:Key="StatusDangerText">#FFF87171</Color>
    <Color x:Key="StatusDangerSoft">#22EF4444</Color>

    <Color x:Key="StatusWarning">#FFF59E0B</Color>
    <Color x:Key="StatusWarningText">#FFFBBF24</Color>
    <Color x:Key="StatusWarningSoft">#22F59E0B</Color>

    <Color x:Key="StatusInfo">#FF3B82F6</Color>
    <Color x:Key="StatusInfoText">#FF60A5FA</Color>
    <Color x:Key="StatusInfoSoft">#223B82F6</Color>

    <!-- ── Shield score (Fase 2) ────────────────────────────────────────-->
    <Color x:Key="ShieldRed">#FFEF4444</Color>
    <Color x:Key="ShieldYellow">#FFF59E0B</Color>
    <Color x:Key="ShieldGreen">#FF10B981</Color>
    <Color x:Key="ShieldGold">#FFD4AF37</Color>
    <Color x:Key="ShieldNeutral">#FF4A4A5C</Color>

    <!-- ── Containers ───────────────────────────────────────────────────
         Hues preserved from v2.4 (cyan/lime/pink/amber) so users keep the
         same mental mapping, but desaturated out of the neon range. -->
    <Color x:Key="ContainerPersonal">#FF3B82F6</Color>
    <Color x:Key="ContainerWork">#FF10B981</Color>
    <Color x:Key="ContainerBanking">#FFF43F5E</Color>
    <Color x:Key="ContainerShopping">#FFF59E0B</Color>
    <Color x:Key="ContainerNone">#FF6C6C80</Color>

    <!-- ══ Brushes ══════════════════════════════════════════════════════
         Consumers bind to the *Brush keys via DynamicResource. The bare
         Color keys above exist for gradient stops and for C# lookups in
         ThemePalette. -->

    <SolidColorBrush x:Key="SurfaceCanvasBrush"   Color="{StaticResource SurfaceCanvas}" />
    <SolidColorBrush x:Key="SurfaceBaseBrush"     Color="{StaticResource SurfaceBase}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush"   Color="{StaticResource SurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush"  Color="{StaticResource SurfaceOverlay}" />
    <SolidColorBrush x:Key="SurfaceInputBrush"    Color="{StaticResource SurfaceInput}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush"   Color="{StaticResource SurfaceActive}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush"  Color="{StaticResource SurfaceSelected}" />
    <SolidColorBrush x:Key="OverlaySelectedBrush"  Color="{StaticResource OverlaySelected}" />
    <SolidColorBrush x:Key="OverlayHoverBrush"     Color="{StaticResource OverlayHover}" />
    <SolidColorBrush x:Key="ScrimBrush"            Color="{StaticResource Scrim}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{StaticResource TextOnAccent}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="BorderFocusBrush"  Color="{StaticResource Accent}" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="AccentTextBrush"    Color="{StaticResource AccentText}" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource AccentSoft}" />

    <SolidColorBrush x:Key="StatusSuccessBrush"     Color="{StaticResource StatusSuccess}" />
    <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="{StaticResource StatusSuccessText}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBrush" Color="{StaticResource StatusSuccessSoft}" />
    <SolidColorBrush x:Key="StatusDangerBrush"      Color="{StaticResource StatusDanger}" />
    <SolidColorBrush x:Key="StatusDangerTextBrush"  Color="{StaticResource StatusDangerText}" />
    <SolidColorBrush x:Key="StatusDangerSoftBrush"  Color="{StaticResource StatusDangerSoft}" />
    <SolidColorBrush x:Key="StatusWarningBrush"     Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="StatusWarningTextBrush" Color="{StaticResource StatusWarningText}" />
    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="{StaticResource StatusWarningSoft}" />
    <SolidColorBrush x:Key="StatusInfoBrush"        Color="{StaticResource StatusInfo}" />
    <SolidColorBrush x:Key="StatusInfoTextBrush"    Color="{StaticResource StatusInfoText}" />
    <SolidColorBrush x:Key="StatusInfoSoftBrush"    Color="{StaticResource StatusInfoSoft}" />

    <SolidColorBrush x:Key="ShieldRedBrush"     Color="{StaticResource ShieldRed}" />
    <SolidColorBrush x:Key="ShieldYellowBrush"  Color="{StaticResource ShieldYellow}" />
    <SolidColorBrush x:Key="ShieldGreenBrush"   Color="{StaticResource ShieldGreen}" />
    <SolidColorBrush x:Key="ShieldGoldBrush"    Color="{StaticResource ShieldGold}" />
    <SolidColorBrush x:Key="ShieldNeutralBrush" Color="{StaticResource ShieldNeutral}" />

    <SolidColorBrush x:Key="ContainerPersonalBrush" Color="{StaticResource ContainerPersonal}" />
    <SolidColorBrush x:Key="ContainerWorkBrush"     Color="{StaticResource ContainerWork}" />
    <SolidColorBrush x:Key="ContainerBankingBrush"  Color="{StaticResource ContainerBanking}" />
    <SolidColorBrush x:Key="ContainerShoppingBrush" Color="{StaticResource ContainerShopping}" />
    <SolidColorBrush x:Key="ContainerNoneBrush"     Color="{StaticResource ContainerNone}" />

    <!-- ── Gradients ────────────────────────────────────────────────────-->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Accent}" Offset="0" />
        <GradientStop Color="{StaticResource AccentHover}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFDC2626" Offset="0" />
        <GradientStop Color="{StaticResource StatusDanger}" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Elevation ────────────────────────────────────────────────────
         Shadows are theme-owned: a black 45%-opacity shadow that reads as
         depth on #0B0B12 turns into a dirty smudge on #F4F4F8. Templates
         reference these by key, never inline a DropShadowEffect. -->
    <DropShadowEffect x:Key="ShadowSm" Color="#FF000000" BlurRadius="8"  ShadowDepth="1" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="ShadowMd" Color="#FF000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.50" />
    <DropShadowEffect x:Key="ShadowLg" Color="#FF000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" />
    <DropShadowEffect x:Key="ShadowAccent" Color="#FF7C5CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="ShadowDanger" Color="#FFEF4444" BlurRadius="14" ShadowDepth="0" Opacity="0.30" />

</ResourceDictionary>
